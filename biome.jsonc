{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "**",
      "!.agents",
      "!.claude/*",
      ".claude/settings.json",
      "!pnpm-lock.yaml",
      "!skills-lock.json"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "rules": {
      "style": {
        "useBlockStatements": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedPackageJson": "on"
      }
    }
  },
  "formatter": {
    "indentStyle": "space",
    "useEditorconfig": true
  }
}
