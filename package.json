{
  "name": "redis-ts",
  "version": "0.0.0",
  "private": true,
  "description": "A Redis like in-memory database built using TypeScript.",
  "keywords": [
    "Database",
    "Redis",
    "TypeScript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohrb/redis-ts.git"
  },
  "author": {
    "name": "Sohrab Chegini",
    "email": "sohrab.chegini@gmail.com"
  },
  "type": "module",
  "imports": {
    "#/*.ts": {
      "types": "./src/*.ts",
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.app.json",
    "check": "biome check --error-on-warnings",
    "clean": "git clean -Xdf",
    "dev": "node --conditions=development --watch src/main.ts",
    "fmt": "biome format --write",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "error"
    }
  }
}
